# EDU Standalone — Entorno Python
# ================================
# Este archivo define el entorno requerido para ejecutar el pipeline de filminas.
# NO commitear este archivo si contiene valores de producción (ya está en .gitignore).
#
# Uso: source .env   (opcional, las rutas se resuelven automáticamente por el pipeline)

# ── Python ───────────────────────────────────────────────────────────────────
PYTHON_MIN_VERSION=3.10
# Ruta al venv del proyecto (relativa a la raíz del repositorio)
VENV_PATH=.venv
# Intérprete a usar (se puede sobreescribir si usás pyenv, conda, etc.)
PYTHON_BIN=python3

# ── Dependencias del pipeline ─────────────────────────────────────────────────
# Versiones mínimas requeridas (las exactas instaladas están en scripts/requirements.txt)
#   google-api-python-client  >= 2.100.0
#   google-auth-oauthlib      >= 1.1.0
#   google-auth-httplib2      >= 0.1.1
#   pyyaml                    >= 6.0.1
#   requests                  >= 2.31.0
#   matplotlib                >= 3.7.0
#   Pillow                    >= 10.0.0

# ── Credenciales Google (no cambiar rutas, son relativas al project-root) ─────
EDU_CREDENTIALS_PATH=_edu/credentials.json
EDU_TOKEN_PATH=_edu/token_slides.json
EDU_SECRETS_PATH=_edu/secrets.local.yaml

# ── Config EDU ────────────────────────────────────────────────────────────────
EDU_CONFIG_PATH=_edu/slides-config.yaml
EDU_PIPELINE_SCRIPT=salida/edu-standalone/scripts/slides_pipeline.py

# ── Chroma MCP ──────────────────────────────────────────────────────────────
# Variables de entorno para MCP/Chroma
# CHROMA_CLIENT_TYPE=persistent
# CHROMA_DATA_DIR=/ruta/a/chroma_data
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
CHROMA_DOTENV_PATH=/home/matiasgel/Documentos/paradigmas2026/.env
EDU_CHROMA_PATH=/home/matiasgel/chromadb/lenguajes/chroma_db
