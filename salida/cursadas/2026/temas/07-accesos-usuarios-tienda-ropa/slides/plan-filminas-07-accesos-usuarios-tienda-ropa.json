      "id": "F-32",
      "type": "codigo",
      "title": "El cliente autenticado obtiene un carrito persistente",
      "subtitle": "orders incorpora Cart y CartItem",
      "body_blocks": [],
      "code_blocks": [
        {
          "lang": "python",
          "content": "class Cart(models.Model):\n    user = models.OneToOneField(settings.AUTH_USER_MODEL, ...)\n\nclass CartItem(models.Model):\n    cart = models.ForeignKey(Cart, related_name=\"items\", ...)\n    variant = models.ForeignKey(\"products.ProductVariant\", ...)\n    quantity = models.PositiveIntegerField(default=1)"
        }
