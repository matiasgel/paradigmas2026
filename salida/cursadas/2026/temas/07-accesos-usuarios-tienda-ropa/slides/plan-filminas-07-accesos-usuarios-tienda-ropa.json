      "id": "F-16",
      "type": "codigo",
      "title": "Modelamos catálogo, imágenes y variantes",
      "subtitle": "El stock pertenece a ProductVariant",
      "body_blocks": [],
      "code_blocks": [
        {
          "lang": "python",
          "content": "class ProductVariant(models.Model):\n    product = models.ForeignKey(Product, related_name=\"variants\", ...)\n    size = models.CharField(max_length=10)\n    color = models.CharField(max_length=40)\n    sku = models.CharField(max_length=40, unique=True)\n    price = models.DecimalField(max_digits=10, decimal_places=2)\n    stock = models.PositiveIntegerField(default=0)"
        }
