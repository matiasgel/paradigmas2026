          "lang": "python",
          "content": "CART_SESSION_KEY = \"cart\"\n\ncart = request.session.setdefault(CART_SESSION_KEY, {})\nkey = str(variant.id)\ncart[key] = min(cart.get(key, 0) + 1, variant.stock)\nrequest.session.modified = True"
        }
