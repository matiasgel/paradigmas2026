    {
      "id": "F-09",
      "type": "codigo",
      "title": "Composición en TypeScript",
      "subtitle": "Composición funcional en TypeScript",
      "body_blocks": [],
      "code_blocks": [
        {
          "lang": "typescript",
          "content": "type Transform<T> = (items: T[]) => T[];\n\nconst filterPares: Transform<number> = items =>\n  items.filter(n => n % 2 === 0);\n\nconst mapCuadrado: Transform<number> = items =>\n  items.map(n => n * n);\n\nconst compose = <T>(...fns: Transform<T>[]) =>\n  (input: T[]) => fns.reduce((acc, fn) => fn(acc), input);\n\nconst pipeline = compose(filterPares, mapCuadrado);"
        }
      ],
      "tables": [],
